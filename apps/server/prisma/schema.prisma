generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ArticleOrigin {
  ORIGINAL
  REPOSTED
}

enum ArticleCommentStatus {
  VISIBLE
  HIDDEN
}

enum GuestbookMessageStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum ArticleAiSummaryStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum AssistantTurnStatus {
  RUNNING
  CANCELLING
  COMPLETED
  CANCELLED
  FAILED
  INTERRUPTED
}

enum AssistantActionStatus {
  PENDING
  APPLIED
  REJECTED
}

enum OAuthDeviceStatus {
  PENDING
  APPROVED
  DENIED
  CONSUMED
}

model Article {
  id             String                    @id @default(uuid()) @db.Uuid
  slug           String                    @unique
  title          String
  description    String
  markdown       String
  status         ArticleStatus
  origin         ArticleOrigin             @default(ORIGINAL)
  sourceName     String?                   @map("source_name")
  sourceAuthor   String?                   @map("source_author")
  sourceUrl      String?                   @map("source_url")
  categoryId     String?                   @map("category_id") @db.Uuid
  coverImageUrl  String?                   @map("cover_image_url")
  wordCount      Int                       @map("word_count")
  readingMinutes Int                       @map("reading_minutes")
  publishedAt    DateTime?                 @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  category       ArticleCategory?          @relation(fields: [categoryId], references: [id])
  tags           ArticleTagLink[]
  revisions      ArticleRevision[]
  comments       ArticleComment[]
  aiSummary      ArticleAiSummary?
  editorDrafts   AdminArticleEditorDraft[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([origin, status, publishedAt(sort: Desc)])
  @@index([categoryId])
  @@map("articles")
}

model ArticleAiSummary {
  id            String                 @id @default(uuid()) @db.Uuid
  articleId     String                 @unique @map("article_id") @db.Uuid
  summary       String?
  status        ArticleAiSummaryStatus @default(PENDING)
  contentHash   String                 @map("content_hash")
  promptVersion String                 @map("prompt_version")
  provider      String?
  model         String?
  attemptCount  Int                    @default(0) @map("attempt_count")
  errorMessage  String?                @map("error_message")
  generatedAt   DateTime?              @map("generated_at") @db.Timestamptz(6)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  article       Article                @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
  @@map("article_ai_summaries")
}

model User {
  id                     String                    @id @default(uuid()) @db.Uuid
  githubId               String                    @unique @map("github_id")
  login                  String
  name                   String?
  email                  String?
  avatarUrl              String?                   @map("avatar_url")
  profileUrl             String                    @map("profile_url")
  createdAt              DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions               UserSession[]
  articleComments        ArticleComment[]
  articleCommentLikes    ArticleCommentLike[]
  guestbookMessages      GuestbookMessage[]
  guestbookMessageLikes  GuestbookMessageLike[]
  adminOperationLogs     AdminOperationLog[]
  articleEditorDrafts    AdminArticleEditorDraft[]
  assistantConversations AssistantConversation[]
  oauthDevices           OAuthDeviceAuthorization[]
  oauthAccessTokens      OAuthAccessToken[]

  @@map("users")
}

model AdminArticleEditorDraft {
  id                   String        @id @default(uuid()) @db.Uuid
  ownerUserId          String        @map("owner_user_id") @db.Uuid
  scope                String
  articleId            String?       @map("article_id") @db.Uuid
  title                String
  description          String
  markdown             String
  status               ArticleStatus @default(DRAFT)
  origin               ArticleOrigin @default(ORIGINAL)
  sourceName           String?       @map("source_name")
  sourceAuthor         String?       @map("source_author")
  sourceUrl            String?       @map("source_url")
  categorySlug         String?       @map("category_slug")
  tagSlugs             String[]      @default([]) @map("tag_slugs")
  coverImageUrl        String?       @map("cover_image_url")
  baseArticleUpdatedAt DateTime?     @map("base_article_updated_at") @db.Timestamptz(6)
  clientSavedAt        DateTime?     @map("client_saved_at") @db.Timestamptz(6)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner                User          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  article              Article?      @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, scope])
  @@index([ownerUserId, updatedAt(sort: Desc)])
  @@index([articleId])
  @@index([categorySlug])
  @@index([tagSlugs], type: Gin)
  @@map("admin_article_editor_drafts")
}

model UserSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model OAuthDeviceAuthorization {
  id              String            @id @default(uuid()) @db.Uuid
  deviceCodeHash  String            @unique @map("device_code_hash")
  userCodeHash    String            @unique @map("user_code_hash")
  clientId        String            @map("client_id")
  scope           String
  status          OAuthDeviceStatus @default(PENDING)
  userId          String?           @map("user_id") @db.Uuid
  expiresAt       DateTime          @map("expires_at") @db.Timestamptz(6)
  intervalSeconds Int               @default(5) @map("interval_seconds")
  nextPollAt      DateTime?         @map("next_poll_at") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("oauth_device_authorizations")
}

model OAuthAccessToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  clientId  String   @map("client_id")
  scope     String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("oauth_access_tokens")
}

model ArticleComment {
  id                String               @id @default(uuid()) @db.Uuid
  articleId         String               @map("article_id") @db.Uuid
  authorId          String               @map("author_id") @db.Uuid
  parentCommentId   String?              @map("parent_comment_id") @db.Uuid
  body              String
  likeCount         Int                  @default(0) @map("like_count")
  status            ArticleCommentStatus @default(VISIBLE)
  moderationVersion Int                  @default(0) @map("moderation_version")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  article           Article              @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author            User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentComment     ArticleComment?      @relation("ArticleCommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies           ArticleComment[]     @relation("ArticleCommentReplies")
  likes             ArticleCommentLike[]

  @@index([articleId, parentCommentId, status, createdAt])
  @@index([authorId])
  @@index([parentCommentId])
  @@map("article_comments")
}

model ArticleCommentLike {
  commentId String         @map("comment_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  comment   ArticleComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("article_comment_likes")
}

model GuestbookMessage {
  id               String                 @id @default(uuid()) @db.Uuid
  authorUserId     String?                @map("author_user_id") @db.Uuid
  guestNickname    String?                @map("guest_nickname")
  guestFingerprint String?                @map("guest_fingerprint")
  body             String
  likeCount        Int                    @default(0) @map("like_count")
  status           GuestbookMessageStatus @default(VISIBLE)
  isPinned         Boolean                @default(false) @map("is_pinned")
  pinnedAt         DateTime?              @map("pinned_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  author           User?                  @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  likes            GuestbookMessageLike[]

  @@index([status, isPinned, pinnedAt(sort: Desc), createdAt(sort: Desc)])
  @@index([authorUserId])
  @@index([guestFingerprint, createdAt])
  @@map("guestbook_messages")
}

model GuestbookMessageLike {
  messageId String           @map("message_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  message   GuestbookMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
  @@map("guestbook_message_likes")
}

model ArticleCategory {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  articles    Article[]

  @@map("article_categories")
}

model ArticleTag {
  id        String           @id @default(uuid()) @db.Uuid
  slug      String           @unique
  name      String
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  articles  ArticleTagLink[]

  @@map("article_tags")
}

model ArticleTagLink {
  articleId String     @map("article_id") @db.Uuid
  tagId     String     @map("tag_id") @db.Uuid
  article   Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       ArticleTag @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("article_tag_links")
}

model ArticleRevision {
  id          String   @id @default(uuid()) @db.Uuid
  articleId   String   @map("article_id") @db.Uuid
  title       String
  description String
  markdown    String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("article_revisions")
}

model SiteAnnouncement {
  id            String   @id @default(uuid()) @db.Uuid
  key           String   @unique
  title         String
  icon          String
  iconClassName String   @map("icon_class_name")
  process       String
  status        String
  command       String
  output        String
  isEnabled     Boolean  @default(true) @map("is_enabled")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isEnabled, sortOrder])
  @@map("site_announcements")
}

model SiteSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_settings")
}

model AdminOperationLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  actorLogin   String   @map("actor_login")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  summary      String
  metadata     Json?
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([actorLogin, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("admin_operation_logs")
}

model AssistantConversation {
  id          String          @id @default(uuid()) @db.Uuid
  ownerUserId String          @map("owner_user_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner       User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  turns       AssistantTurn[]

  @@index([ownerUserId, createdAt(sort: Desc)])
  @@map("assistant_conversations")
}

model AssistantTurn {
  id             String                @id @default(uuid()) @db.Uuid
  conversationId String                @map("conversation_id") @db.Uuid
  requestId      String                @map("request_id") @db.VarChar(200)
  inputHash      String                @map("input_hash")
  input          String
  status         AssistantTurnStatus   @default(RUNNING)
  transcript     Json                  @default("{\"version\":1,\"messages\":[]}")
  errorCode      String?               @map("error_code")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actions        AssistantAction[]

  @@unique([conversationId, requestId])
  @@unique([id, conversationId])
  @@index([conversationId, createdAt, id])
  // The migration enforces one RUNNING/CANCELLING turn per conversation with a partial unique index.
  @@map("assistant_turns")
}

model AssistantAction {
  id              String                @id @default(uuid()) @db.Uuid
  conversationId  String                @map("conversation_id") @db.Uuid
  turnId          String                @map("turn_id") @db.Uuid
  toolCallId      String                @map("tool_call_id") @db.VarChar(500)
  commentId       String                @map("comment_id") @db.Uuid
  currentStatus   ArticleCommentStatus  @map("current_status")
  targetStatus    ArticleCommentStatus  @map("target_status")
  targetVersion   Int                   @map("target_version")
  preview         Json
  status          AssistantActionStatus @default(PENDING)
  decidedByUserId String?               @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime?             @map("decided_at") @db.Timestamptz(6)
  receipt         Json?
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  turn            AssistantTurn         @relation(fields: [turnId, conversationId], references: [id, conversationId], onDelete: Cascade)

  @@unique([turnId, toolCallId])
  @@index([conversationId, createdAt])
  @@map("assistant_actions")
}
